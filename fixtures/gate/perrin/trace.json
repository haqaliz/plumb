{"argv":["python","-c","import glob\nimport json\nimport os\nimport numpy as np\nimport pandas as pd\n\nos.chdir(\"hte/experiments\")\nfrom hte.experiments.launch_expe import find_upper_bound\nfrom hte.experiments.run_experiments import power_analysis\n\nos.makedirs(\"results_expe/raw_results\", exist_ok=True)\nos.makedirs(\"results_expe/processed_results\", exist_ok=True)\nos.makedirs(\"results_expe/reduced\", exist_ok=True)\n\nGRIDS = {\n    \"p20\": \"../data/results_compute_arr/Cox_Weibull_1.0_2.0_dim=20_range=[-10.0,10.0]_nb=500_group=[dim20_pred4_prog0_balanced]_July_07_12_2023_15:15:24.json\",\n    \"p100\": \"../data/results_compute_arr/Cox_Weibull_1.0_2.0_dim=100_range=[-10.0,10.0]_nb=500_group=[dim100_pred4_prog0_balanced]_July_07_25_2023_16:08:59.json\",\n}\nMETHODS = {\n    \"p20\": \"Oracle, Univariate interaction, Univariate t_test, Multivariate cox, Multivariate tree, MOB, ITree, SIDES, SeqBT, ARDP\",\n    \"p100\": \"Oracle, Univariate interaction, Univariate t_test, Multivariate cox, Multivariate tree, MOB, ITree, ARDP\",\n}\n\nfor name in (\"p20\", \"p100\"):\n    dim = name[1:]\n    with open(GRIDS[name]) as f:\n        dict_param = json.load(f)\n    upper, _ = find_upper_bound(dict_param)\n    np.random.seed(seed=42)\n    power_analysis(\n        arrs=np.linspace(0.0, float(upper), 1),\n        dict_param_path=GRIDS[name], train_size=250, test_size=250,\n        repet=1000, censored=True, scale=1.0, semi_synth=False,\n        methods=METHODS[name])\n    fresh = glob.glob(\"results_expe/processed_results/*dim={}_range=*scale=1.0*.csv\".format(dim))\n    if len(fresh) != 1:\n        raise SystemExit(\"expected one fresh processed CSV for p{}, found {}\".format(dim, fresh))\n    df = pd.read_csv(fresh[0], index_col=0)\n    reduced = df.groupby(\"method\")[\"thresh_pval\"].mean().reset_index()\n    reduced.to_csv(\"results_expe/reduced/type1_{}.csv\".format(name), index=False)\n    os.remove(fresh[0])\n    for leftover in glob.glob(\"results_expe/raw_results/*\"):\n        os.remove(leftover)\n    print(\"===== {}\".format(name))\n    print(reduced.to_string(index=False))\n"],"artifacts":[{"diagnostic_only":false,"kind":"csv","mtime_ns":1791230640852289847,"relpath":"hte/experiments/results_expe/reduced/type1_p100.csv","sha256":"1d1e1316a51954804c8d8afa4f6b95ad08163decd8fd29e210a51098cb795616","size":163},{"diagnostic_only":false,"kind":"csv","mtime_ns":1791227978810228421,"relpath":"hte/experiments/results_expe/reduced/type1_p20.csv","sha256":"f9cb8c5ebc63229e52d1927b259cfe82aa706560e16618f1dd35f643beb3f941","size":188},{"diagnostic_only":true,"kind":"stderr","mtime_ns":null,"relpath":"<stderr>","sha256":"0819fc3e585daec251d18adc96423abf8082ceb82b8d53cb66ce3755a35d25bb","size":184099770},{"diagnostic_only":false,"kind":"stdout","mtime_ns":null,"relpath":"<stdout>","sha256":"3b736f1f093a4d991d0635435a9ca6dc32f6f9f90750612372cb74f89aa08d34","size":2351}],"causes":[],"cwd":".","entrypoint_source":"explicit","env_policy":"best-effort","exit_code":0,"failure":null,"run_id":"38dee9c8d1dfdef67bfbb842eede61b229fdf021f2fe797aa140d36208831fa1","stale":[{"cause":"STALE_ARTIFACT","mtime_ns":1791212398717084915,"relpath":"hte/configs/data_configs/dim1000_isotropic_pro(+)10_pro(-)10_noise480.json","size":0},{"cause":"STALE_ARTIFACT","mtime_ns":1791212398730271581,"relpath":"hte/configs/data_configs/dim1000_isotropic_pro(+)10_pro(-)10_noise500.json","size":17046723},{"cause":"STALE_ARTIFACT","mtime_ns":1791212398730568908,"relpath":"hte/configs/data_configs/dim100_isotropic_pro(+)5_pro(-)5_noise50.json","size":174753},{"cause":"STALE_ARTIFACT","mtime_ns":1791212398730695031,"relpath":"hte/configs/data_configs/dim20_isotropic_pro(+)5_pro(-)5.json","size":7788},{"cause":"STALE_ARTIFACT","mtime_ns":1791212398774625068,"relpath":"hte/configs/data_configs/gamma_semi_synthetic_p1000.json","size":33362307},{"cause":"STALE_ARTIFACT","mtime_ns":1791212398783854267,"relpath":"hte/configs/data_configs/semi_synthetic_p1000.csv","size":5