   "source": [
    "# Publication grid: 61 x 61.  The draft notebook used a 21 x 21\n",
    "# interactive grid; the paper figure was generated on this finer grid.\n",
    "# A Numba-specialized implementation preserves the method-of-steps/RK4\n",
    "# arithmetic while making the publication sweep practical to rerun.\n",
    "try:\n",
    "    from numba import njit, prange, set_num_threads\n",
    "    HAVE_NUMBA = True\n",
    "except ImportError:\n",
    "    HAVE_NUMBA = False\n",
    "\n",
    "weak_sweep = replace(weak, dt=0.02, horizon=140.0)\n",
    "t_soft_sweep, x_soft_sweep = integrate_scenario(weak_sweep, recursive=True)\n",
    "T_AGI_SOFT_SWEEP = threshold_time(t_soft_sweep, x_soft_sweep, weak_sweep.x_agi)\n",
    "T_ASI_SOFT_SWEEP = threshold_time(t_soft_sweep, x_soft_sweep, weak_sweep.x_asi)\n",
    "DELTA_SOFT_SWEEP = T_ASI_SOFT_SWEEP - T_AGI_SOFT_SWEEP\n",
    "\n",
    "headroom_grid = np.geomspace(0.5, 16.0, 61)\n",
    "growth_grid = np.linspace(0.15, 0.55, 61)\n",
    "\n",
    "if not HAVE_NUMBA:\n",
    "    raise ImportError(\n",
    "        'Exact publication-grid recomputation requires numba. '\n",
    "        'Install numba, then rerun this cell.'\n",
    "    )\n",
    "\n",
    "# Constants specialized from the weak-supercritical reference scenario.\n",
    "_dt = float(weak_sweep.dt)\n",
    "_horizon = float(weak_sweep.horizon)\n",
    "_n = int(math.ceil(_horizon / _dt))\n",
    "_X = float(weak_sweep.X)\n",
    "_beta = float(weak_sweep.beta)\n",
    "_tau = float(weak_sweep.delay(0.0))\n",
    "_r = float(weak_sweep.r(0.0))\n",
    "_a = float(weak_sweep.gain_profile.a)\n",
    "_k = float(weak_sweep.gain_profile.k)\n",
    "_x0 = float(weak_sweep.x0)\n",
    "_x_agi = float(weak_sweep.x_agi)\n",
    "_x_asi = float(weak_sweep.x_asi)\n",
    "_Q = float(POWER_Q)\n",
    "\n",
    "@njit\n",
    "def _pub_potential(x):\n",
    "    return (_a / _k) * math.log((math.exp(_k * x) + 1.0) / 2.0)\n",
    "\n",
    "@njit\n",
    "def _pub_interp_history(values, current_index, query):\n",
    "    if query <= 0.0:\n",
    "        return _x0\n",
    "    q = query / _dt\n",
    "    j = int(math.floor(q))\n",
    "    frac = q - j\n",
    "    if j >= current_index:\n",
    "        return values[current_index]\n",
    "    j1 = j + 1\n",
    "    if j1 > current_index:\n",
    "        j1 = current_index\n",
    "    return (1.0 - frac) * values[j] + frac * values[j1]\n",
    "\n",
    "@njit\n",
    "def _pub_ceiling(t, log_headroom0, g_phys, kappa):\n",
    "    cap = _x0 + (log_headroom0 + g_phys * t) / kappa\n",
    "    max_cap = _X * (1.0 - 1e-10)\n",
    "    return cap if cap < max_cap else max_cap\n",
    "\n",
    "@njit\n",
    "def _pub_rhs(t, x, values, current_index, log_headroom0, g_phys, kappa):\n",
    "    if x >= _X:\n",
    "        return 0.0\n",
    "    xd = _pub_interp_history(values, current_index, t - _tau)\n",
    "    frontier = max(1.0 - x / _X, 0.0) ** _beta\n",
    "    exponent = _pub_potential(xd)\n",
    "    if exponent < -50.0:\n",
    "        exponent = -50.0\n",
    "    elif exponent > 50.0:\n",
    "        exponent = 50.0\n",
    "    return _r * frontier * math.exp(exponent)\n",
    "\n",
    "@njit\n",
    "def _pub_integrate_one(F, g_phys):\n",
    "    kappa = math.log(_Q) / (_x_asi - _x_agi)\n",
    "    log_headroom0 = (\n",
    "        math.log(F)\n",
    "        + kappa * (_x_agi - _x0)\n",
    "        - g_phys * T_AGI_SOFT_SWEEP\n",
    "    )\n",
    "    if log_headroom0 < 0.0:\n",
    "        return np.nan, np.nan, np.nan\n",
    "\n",
    "    x = np.empty(_n + 1, dtype=np.float64)\n",
    "    x[0] = _x0\n",
    "    cap0 = _pub_ceiling(0.0, log_headroom0, g_phys, kappa)\n",
    "    t_bind = 0.0 if abs(x[0] - cap0) <= 1e-8 else np.nan\n",
    "\n",
    "    for i in range(_n):\n",
    "        ti = i * _dt\n",
    "        tn = (i + 1) * _dt\n",
    "        tm = ti + 0.5 * _dt\n",
    "        xi = x[i]\n",
    "\n",
    "        k1 = _pub_rhs(ti, xi, x, i, log_headroom0, g_phys, kappa)\n",
    "\n",
    "        x2 = xi + _dt * k1 / 2.0\n",
    "        cap = _pub_ceiling(tm, log_headroom0, g_phys, kappa)\n",
    "        if x2 > cap:\n",
    "            x2 = cap\n",
    "        k2 = _pub_rhs(tm, x2, x, i, log_headroom0, g_phys, kappa)\n",
    "\n",
    "        x3 = xi + _dt * k2 / 2.0\n",
    "        cap = _pub_ceiling(tm, log_headroom0, g_phys, kappa)\n",
    "        if x3 > cap:\n",
    "            x3 = cap\n",
    "        k3 = _pub_rhs(tm, x3, x, i, log_headroom0, g_phys, kappa)\n",
    "\n",
    "        x4 = xi + _dt * k3\n",
    "        cap = _pub_ceiling(tn, log_headroom0, g_phys, kappa)\n",
    "        if x4 > cap:\n",
    "            x4 = cap\n",
    "        k4 = _pub_rhs(tn, x4, x, i, log_headroom0, g_phys, kappa)\n",
    "\n",
    "        candidate = xi + _dt * (k1 + 2*k2 + 2*k3 + k4) / 6.0\n",
    "        candidate = min(max(candidate, 0.0), _X * (1.0 - 1e-10))\n",
    "        cap = _pub_ceiling(tn, log_headroom0, g_phys, kappa)\n",
    "        xn = candidate if candidate < cap else cap\n",
    "        x[i + 1] = xn\n",
    "\n",
    "        if math.isnan(t_bind) and abs(xn - cap) <= 1e-8:\n",
    "            t_bind = tn\n",
    "\n",
    "    T_AGI = np.nan\n",
    "    T_ASI = np.nan\n",
    "    for i in range(1, _n + 1):\n",
    "        if math.isnan(T_AGI) and x[i] >= _x_agi:\n",
    "            T_AGI = (i - 1) * _dt + (_x_agi - x[i-1]) * _dt / (x[i] - x[i-1])\n",
    "        if math.isnan(T_ASI) and x[i] >= _x_asi:\n",
    "            T_ASI = (i - 1) * _dt + (_x_asi - x[i-1]) * _dt / (x[i] - x[i-1])\n",
    "            break\n",
    "    return T_AGI, T_ASI, t_bind\n",
    "\n",
    "@njit(parallel=True)\n",
    "def _pub_sweep(headrooms, growths):\n",
    "    ng = len(growths)\n",
    "    nh = len(headrooms)\n",
    "    T_AGI = np.full((ng, nh), np.nan)\n",
    "    T_ASI = np.full((ng, nh), np.nan)\n",
    "    delta = np.full((ng, nh), np.nan)\n",
    "    extra = np.full((ng, nh), np.nan)\n",
    "    T_bind = np.full((ng, nh), np.nan)\n",
    "    regime = np.full((ng, nh), np.nan)\n",
    "\n",
    "    for idx in prange(ng * nh):\n",
    "        ig = idx // nh\n",
    "        ih = idx - ig * nh\n",
    "        ta, ts, tb = _pub_integrate_one(headrooms[ih], growths[ig])\n",
    "\n",
    "        if math.isnan(ta) and math.isnan(ts) and math.isnan(tb):\n",
    "            continue\n",
    "\n",
    "        if not math.isnan(ta):\n",
    "            T_AGI[ig, ih] = ta\n",
    "        if not math.isnan(ts):\n",
    "            T_ASI[ig, ih] = ts\n",
    "        if not math.isnan(tb):\n",
    "            T_bind[ig, ih] = tb\n",
    "\n",
    "        if not math.isnan(ta) and not math.isnan(ts):\n",
    "            d = ts - ta\n",
    "            delta[ig, ih] = d\n",
    "            extra[ig, ih] = d - DELTA_SOFT_SWEEP\n",
    "\n",
    "        regime[ig, ih] = 0.0\n",
    "        if not math.isnan(tb):\n",
    "            if not math.isnan(ta) and tb < ta:\n",
    "                regime[ig, ih] = 2.0\n",
    "            elif not math.isnan(ts) and tb < ts:\n",
    "                regime[ig, ih] = 1.0\n",
    "\n",
    "    return T_AGI, T_ASI, delta, extra, T_bind, regime\n",
    "\n",
    "set_num_threads(min(5, os.cpu_count() or 1))\n",
    "(\n",
    "    panelB_T_AGI,\n",
