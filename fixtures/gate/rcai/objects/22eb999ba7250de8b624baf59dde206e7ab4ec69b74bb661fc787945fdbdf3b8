    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import math\n",
    "\n",
    "def simulate_nonlinear_strategic_network(cfg, horizon=30.0, dt=None):\n",
    "    if dt is None: dt = weak.dt\n",
    "    K = np.asarray(cfg.K, dtype=float)\n",
    "    n_players = K.shape[0]\n",
    "    n_steps = int(math.ceil(horizon / dt))\n",
    "    t = np.linspace(0.0, n_steps * dt, n_steps + 1)\n",
    "    weak_path = np.interp(t, weak_result.time, weak_result.capability)\n",
    "    branch_index = 0\n",
    "    x = np.empty((n_steps + 1, n_players), dtype=float)\n",
    "    x[0, :] = weak.x0\n",
    "    P_star = float(weak.gain_profile.potential(x_star))\n",
    "    frontier_star = max(1.0 - x_star / weak.X, 0.0) ** weak.beta\n",
    "    phi_star = float(np.log(v_star / (weak.r(T_star) * frontier_star)))\n",
    "    B = sigma_star * K / g_star\n",
    "    tau = float(cfg.tau)\n",
    "    def delayed_state(query, current_index):\n",
    "        if query <= 0.0: return np.full(n_players, weak.x0, dtype=float)\n",
    "        q = query / dt; j = int(math.floor(q)); frac = q - j\n",
    "        if j >= current_index: return x[current_index].copy()\n",
    "        j1 = min(j + 1, current_index)\n",
    "        return (1.0 - frac) * x[j] + frac * x[j1]\n",
    "    def network_rhs(time, state, current_index):\n",
    "        xd = delayed_state(time - tau, current_index)\n",
    "        delta_P = np.asarray(weak.gain_profile.potential(xd), dtype=float) - P_star\n",
    "        phi = phi_star + B @ delta_P\n",
    "        frontier = np.maximum(1.0 - state / weak.X, 0.0) ** weak.beta\n",
    "        return cfg.effort_multiplier * weak.r(time) * frontier * np.exp(np.clip(phi, -50.0, 50.0))\n",
    "    for i in range(branch_index, n_steps):\n",
    "        ti, tn = float(t[i]), float(t[i + 1]); tm = 0.5 * (ti + tn); h = tn - ti; xi = x[i].copy()\n",
    "        k1 = network_rhs(ti, xi, i)\n",
    "        x2 = np.minimum(xi + 0.5 * h * k1, weak.X * (1.0 - 1e-10))\n",
    "        k2 = network_rhs(tm, x2, i)\n",
    "        x3 = np.minimum(xi + 0.5 * h * k2, weak.X * (1.0 - 1e-10))\n",
    "        k3 = network_rhs(tm, x3, i)\n",
    "        x4 = np.minimum(xi + h * k3, weak.X * (1.0 - 1e-10))\n",
    "        k4 = network_rhs(tn, x4, i)\n",
    "        x[i + 1] = np.minimum(np.maximum(xi + h * (k1 + 2*k2 + 2*k3 + k4) / 6.0, 0.0), weak.X * (1.0 - 1e-10))\n",
    "    local_R = np.full_like(x, np.nan); network_R = np.full(n_steps + 1, np.nan, dtype=float)\n",
    "    for i in range(branch_index, n_steps + 1):\n",
    "        gains = np.asarray(weak.gain_profile.gain(x[i]), dtype=float)\n",
    "        R_matrix = (B * gains[None, :]) / (weak.beta / np.maximum(weak.X - x[i], 1e-12))[:, None]\n",
    "        local_R[i], network_R[i] = np.diag(R_matrix), spectral_radius(R_matrix)\n",
    "    return {'time': t, 'capability': x, 'local_R': local_R, 'network_R': network_R, 'weak_reference': weak_path}\n",
