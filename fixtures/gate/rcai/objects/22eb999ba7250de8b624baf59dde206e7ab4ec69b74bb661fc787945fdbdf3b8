    "from dataclasses import replace\n",
    "\n",
    "\n",
    "def physical_scenario(\n",
    "    base,\n",
    "    *,\n",
    "    q_agi_to_asi,\n",
    "    headroom_at_agi,\n",
    "    effective_growth,\n",
    "    t_agi_reference,\n",
    "    name=None,\n",
    "    description=None,\n",
    "    dt=None,\n",
    "    horizon=None,\n",
    "):\n",
    "    \"\"\"\n",
    "    Construct a physically constrained copy of an existing scenario.\n",
    "\n",
    "    q_agi_to_asi:\n",
    "        C_req(x_ASI) / C_req(x_AGI)\n",
    "\n",
    "    headroom_at_agi:\n",
    "        C_phys / C_req(x_AGI), evaluated at the unconstrained\n",
    "        AGI crossing time.\n",
    "\n",
    "    effective_growth:\n",
    "        annual exponential growth rate of power-supported\n",
    "        effective compute.\n",
    "    \"\"\"\n",
    "\n",
    "    kappa = (\n",
    "        np.log(q_agi_to_asi)\n",
    "        / (base.x_asi - base.x_agi)\n",
    "    )\n",
    "\n",
    "    log_headroom0 = (\n",
    "        np.log(headroom_at_agi)\n",
    "        + kappa * (base.x_agi - base.x0)\n",
    "        - effective_growth * t_agi_reference\n",
    "    )\n",
    "\n",
    "    kwargs = dict(\n",
    "        hardware_log_headroom0=float(log_headroom0),\n",
    "        hardware_effective_growth=float(effective_growth),\n",
    "        compute_requirement_gradient=float(kappa),\n",
    "    )\n",
    "\n",
    "    if name is not None:\n",
    "        kwargs[\"name\"] = name\n",
    "\n",
    "    if description is not None:\n",
    "        kwargs[\"description\"] = description\n",
    "\n",
    "    if dt is not None:\n",
    "        kwargs[\"dt\"] = dt\n",
    "\n",
    "    if horizon is not None:\n",
    "        kwargs[\"horizon\"] = horizon\n",
    "\n",
    "    return replace(base, **kwargs)\n",
    "\n",
    "\n",
    "def first_binding_time(s, t, x, atol=1e-8):\n",
    "    \"\"\"First time the realized trajectory reaches the physical ceiling.\"\"\"\n",
    "    cap = hardware_ceiling(s, t)\n",
    "\n",
    "    if cap is None:\n",
    "        return None\n",
    "\n",
    "    idx = np.flatnonzero(\n",
    "        np.isclose(x, cap, rtol=0.0, atol=atol)\n",
    "    )\n",
    "\n",
    "    return None if len(idx) == 0 else float(t[idx[0]])\n"
   ]
