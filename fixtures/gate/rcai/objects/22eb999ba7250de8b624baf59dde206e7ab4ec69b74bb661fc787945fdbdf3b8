    "def max_R_surface(beta, gain_rows, x):\n",
    "    peak=np.max(gain_rows*(1-x[None,:]),axis=1)\n",
    "    return peak[:,None]/beta[None,:]\n",
    "\n",
    "def phase_panel(ax,B,Y,Rmax,ylabel,title):\n",
    "    logR=np.log10(np.maximum(Rmax, 1e-9)); norm=TwoSlopeNorm(vmin=-1,vcenter=0,vmax=1)\n",
    "    cf=ax.contourf(B,Y,logR,levels=np.linspace(-1,1,41),cmap='RdBu_r',norm=norm,extend='both')\n",
    "    vals=[0.2,0.4,0.6,0.8,2,3,4,5,6]\n",
    "    cs=ax.contour(B,Y,logR,levels=np.log10(vals),colors='0.25',linewidths=.75)\n",
    "    ax.clabel(cs,fmt={np.log10(v):rf'$\\mathcal{{R}}_{{AI}}={v:g}$' for v in vals},fontsize=8)\n",
    "    crit=ax.contour(B,Y,logR,levels=[0],colors='black',linewidths=2,linestyles='--')\n",
    "    ax.clabel(crit,fmt={0:r'$\\mathcal{R}_{AI}=1$'},fontsize=10)\n",
    "    ax.set_xlim(.1,4); ax.set_xlabel(r'frontier-hardening exponent, $\\beta$'); ax.set_ylabel(ylabel); ax.set_title(title)\n",
    "    ax.axvline(2, color='black', linestyle=':', linewidth=1) # Add dotted vertical line at beta=2\n",
    "    return cf\n",
    "\n",
    "beta=np.linspace(.1,4,200); x=np.linspace(0,1,1400)\n",
    "a_values=np.linspace(0,20,200)\n",
    "\n",
    "gain_rows=np.vstack([GainProfile(REFERENCE_G0,REFERENCE_G_MAX,REFERENCE_K,REFERENCE_X_MID,a).gain(x) for a in a_values])\n",
    "Rg=max_R_surface(beta,gain_rows,x); B1,A=np.meshgrid(beta,a_values)\n",
    "kvals=np.linspace(0,20,200)\n",
    "gain_k=np.vstack([GainProfile(REFERENCE_G0,REFERENCE_G_MAX,kv,x_mid=REFERENCE_X_MID,a=3).gain(x) for kv in kvals])\n",
