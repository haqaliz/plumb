    "@dataclass(frozen=True)\n",
    "class Scenario:\n",
    "    name: str\n",
    "    description: str\n",
    "    X: float\n",
    "    beta: float\n",
    "    x0: float\n",
    "    x_agi: float\n",
    "    x_asi: float\n",
    "    horizon: float\n",
    "    dt: float\n",
    "    gain_profile: GainProfile\n",
    "    r_schedule: SmoothStep\n",
    "    gain_multiplier: SmoothStep\n",
    "    delay_schedule: SmoothStep\n",
    "    throughput_schedule: SmoothStep\n",
    "    history_slope: float=0.0\n",
    "    hardware_log_headroom0: Optional[float]=None\n",
    "    hardware_effective_growth: Optional[float]=None\n",
    "    compute_requirement_gradient: Optional[float]=None\n",
    "    evidence_class: str=\"illustrative\"\n",
    "    def r(self,t): return float(self.r_schedule(t))\n",
    "    def gain_mult(self,t): return float(self.gain_multiplier(t))\n",
    "    def delay(self,t): return float(self.delay_schedule(t))\n",
    "    def throughput(self,t): return float(self.throughput_schedule(t))\n",
    "    def gain(self,x,t): return self.gain_mult(t)*float(self.gain_profile.gain(x))\n",
    "    def potential(self,x,t): return self.gain_mult(t)*float(self.gain_profile.potential(x))\n",
    "\n",
    "@dataclass\n",
    "class SimulationResult:\n",
    "    scenario: Scenario\n",
    "    time: Array\n",
    "    capability: Array\n",
    "    capability_no_rsi: Array\n",
    "    recursive_reproduction: Array\n",
    "    lambda_star: Array\n",
    "    local_velocity: Array\n",
    "    hardware_capability_ceiling: Optional[Array]\n",
    "    capability_hardware_limited: Optional[Array]\n",
    "    metrics: Dict[str, object]\n",
    "\n",
    "\n",
    "def interp_history(values,dt,current_index,query,x0,slope):\n",
    "    if query<=0: return x0+slope*query\n",
    "    q=query/dt; j=int(math.floor(q)); frac=q-j\n",
    "    if j>=current_index: return float(values[current_index])\n",
    "    j1=min(j+1,current_index)\n",
    "    return float((1-frac)*values[j]+frac*values[j1])\n",
    "\n",
    "def rhs(s,t,x,values,i,recursive=True):\n",
    "    if x>=s.X: return 0.0\n",
    "    xd=interp_history(values,s.dt,i,t-s.delay(t),s.x0,s.history_slope)\n",
    "    frontier=max(1-x/s.X,0.0)**s.beta\n",
    "    exponent=s.potential(xd,t) if recursive else 0.0\n",
    "    exponent=np.clip(exponent,-50,50)\n",
    "    return s.throughput(t)*s.r(t)*frontier*math.exp(exponent)\n",
    "\n",
    "def has_physical_constraint(s):\n",
    "    vals = (\n",
    "        s.hardware_log_headroom0,\n",
    "        s.hardware_effective_growth,\n",
    "        s.compute_requirement_gradient,\n",
    "    )\n",
    "\n",
    "    if all(v is None for v in vals):\n",
    "        return False\n",
    "\n",
    "    if any(v is None for v in vals):\n",
    "        raise ValueError(\n",
    "            \"Physical constraint requires hardware_log_headroom0, \"\n",
    "            \"hardware_effective_growth, and compute_requirement_gradient.\"\n",
    "        )\n",
    "\n",
    "    if s.compute_requirement_gradient <= 0:\n",
    "        raise ValueError(\"compute_requirement_gradient must be positive.\")\n",
    "\n",
    "    return True\n",
    "\n",
    "\n",
    "def hardware_ceiling(s, t):\n",
    "    \"\"\"\n",
    "    Maximum physically deployable capability.\n",
    "\n",
    "    Assumes:\n",
    "        C_req(x) / C_req(x0) = exp[kappa * (x - x0)]\n",
    "        C_phys(t) / C_phys(0) = exp[g_phys * t]\n",
    "\n",
    "    hardware_log_headroom0 is ln[C_phys(0) / C_req(x0)].\n",
    "    \"\"\"\n",
    "    if not has_physical_constraint(s):\n",
    "        return None\n",
    "\n",
    "    t = np.asarray(t, dtype=float)\n",
    "\n",
    "    x_cap = (\n",
    "        s.x0\n",
    "        + (\n",
    "            s.hardware_log_headroom0\n",
    "            + s.hardware_effective_growth * t\n",
    "        )\n",
    "        / s.compute_requirement_gradient\n",
    "    )\n",
    "\n",
    "    return np.minimum(\n",
    "        x_cap,\n",
    "        s.X * (1 - 1e-10)\n",
    "    )\n",
    "\n",
    "\n",
    "def constrain_capability(s, t, x):\n",
    "    \"\"\"Apply the moving physical feasibility boundary.\"\"\"\n",
    "    if not has_physical_constraint(s):\n",
    "        return x\n",
    "\n",
    "    cap = hardware_ceiling(s, t)\n",
    "    return np.minimum(x, cap)\n",
    "\n",
    "\n",
    "def integrate_scenario(s, recursive=True):\n",
    "    \"\"\"\n",
    "    Integrate the model with the physical constraint applied inside\n",
    "    the dynamics.\n",
    "\n",
    "    The constrained trajectory is stored in x[], so it subsequently\n",
    "    enters the delayed recursive-feedback term through interp_history().\n",
    "    \"\"\"\n",
    "    n = int(math.ceil(s.horizon / s.dt))\n",
    "    t = np.linspace(0, n * s.dt, n + 1)\n",
    "\n",
    "    x = np.empty(n + 1)\n",
    "    x[0] = s.x0\n",
    "\n",
    "    if has_physical_constraint(s):\n",
    "        if s.x0 > hardware_ceiling(s, 0.0) + 1e-12:\n",
    "            raise ValueError(\n",
    "                \"Initial capability exceeds the physical ceiling.\"\n",
    "            )\n",
    "\n",
    "    for i in range(n):\n",
    "        ti = float(t[i])\n",
    "        tn = float(t[i + 1])\n",
    "        tm = 0.5 * (ti + tn)\n",
    "        xi = float(x[i])\n",
    "        dt = tn - ti\n",
    "\n",
    "        k1 = rhs(\n",
    "            s, ti, xi, x, i, recursive\n",
    "        )\n",
    "\n",
    "        x2 = constrain_capability(\n",
    "            s,\n",
    "            tm,\n",
    "            xi + dt * k1 / 2\n",
    "        )\n",
    "        k2 = rhs(\n",
    "            s, tm, float(x2), x, i, recursive\n",
    "        )\n",
    "\n",
    "        x3 = constrain_capability(\n",
    "            s,\n",
    "            tm,\n",
    "            xi + dt * k2 / 2\n",
    "        )\n",
    "        k3 = rhs(\n",
    "            s, tm, float(x3), x, i, recursive\n",
    "        )\n",
    "\n",
    "        x4 = constrain_capability(\n",
    "            s,\n",
    "            tn,\n",
    "            xi + dt * k3\n",
    "        )\n",
    "        k4 = rhs(\n",
    "            s, tn, float(x4), x, i, recursive\n",
    "        )\n",
    "\n",
    "        candidate = (\n",
    "            xi\n",
    "            + dt * (k1 + 2*k2 + 2*k3 + k4) / 6\n",
    "        )\n",
    "\n",
    "        candidate = min(\n",
    "            max(candidate, 0.0),\n",
    "            s.X * (1 - 1e-10)\n",
    "        )\n",
    "\n",
    "        x[i + 1] = constrain_capability(\n",
    "            s, tn, candidate\n",
    "        )\n",
    "    return t, x\n",
    "\n",
    "def threshold_time(t,x,thr):\n",
    "    idx=np.flatnonzero(x>=thr)\n",
    "    if len(idx)==0: return None\n",
    "    i=int(idx[0])\n",
    "    if i==0: return float(t[0])\n",
    "    return float(t[i-1]+(thr-x[i-1])*(t[i]-t[i-1])/(x[i]-x[i-1]))\n",
    "\n",
    "def crossing_times(t,y,level=1.0):\n",
    "    z=y-level; out=[]\n",
    "    for i in range(1,len(z)):\n",
    "        if z[i-1]*z[i]<=0 and z[i-1]!=z[i]:\n",
    "            frac=-z[i-1]/(z[i]-z[i-1])\n",
    "            out.append((float(t[i-1]+frac*(t[i]-t[i-1])), 'entry' if z[i]>z[i-1] else 'exit'))\n",
    "    return out\n",
    "\n",
    "def local_diagnostics(s,t,x):\n",
    "    # Vectorized diagnostic evaluation.  The trajectory itself is still\n",
    "    # integrated by the method of steps above.\n",
    "    tau=np.asarray(s.delay_schedule(t),dtype=float)\n",
    "    q=t-tau\n",
    "    xd=np.interp(np.maximum(q,0.0),t,x)\n",
    "    neg=q<0\n",
    "    if np.any(neg):\n",
    "        xd[neg]=s.x0+s.history_slope*q[neg]\n",
    "    frontier=np.maximum(1-x/s.X,0.0)**s.beta\n",
    "    r=np.asarray(s.r_schedule(t),dtype=float)\n",
    "    throughput=np.asarray(s.throughput_schedule(t),dtype=float)\n",
    "    gain_mult=np.asarray(s.gain_multiplier(t),dtype=float)\n",
    "    pot=gain_mult*np.asarray(s.gain_profile.potential(xd),dtype=float)\n",
    "    vel=throughput*r*frontier*np.exp(np.clip(pot,-50,50))\n",
    "    sigma=s.beta/np.maximum(s.X-x,1e-12)\n",
    "    g=gain_mult*np.asarray(s.gain_profile.gain(x),dtype=float)\n",
    "    R=g/sigma\n",
    "    arg=vel*g*tau*np.exp(np.minimum(vel*sigma*tau,700.0))\n",
    "    lam=np.real(lambertw(arg,0))/tau-vel*sigma\n",
    "    zero=tau<=1e-12\n",
    "    if np.any(zero): lam[zero]=vel[zero]*(g[zero]-sigma[zero])\n",
    "    return R,lam,vel\n",
    "\n",
    "\n",
    "def simulate(s):\n",
    "    t,x=integrate_scenario(s,True); _,x0=integrate_scenario(s,False)\n",
    "    R,lam,v=local_diagnostics(s,t,x)\n",
    "\n",
    "    h = hardware_ceiling(s, t)\n",
    "\n",
    "    # x is already the physically realized trajectory because the\n",
    "    # constraint is applied inside integrate_scenario().\n",
    "    xh = x.copy() if h is not None else None\n",
    "\n",
    "    ta = threshold_time(t, x, s.x_agi)\n",
    "    ts = threshold_time(t, x, s.x_asi)\n",
    "\n",
    "    ta0 = threshold_time(t, x0, s.x_agi)\n",
    "    ts0 = threshold_time(t, x0, s.x_asi)\n",
    "\n",
    "    tah = ta if h is not None else None\n",
    "    tsh = ts if h is not None else None\n",
    "\n",
