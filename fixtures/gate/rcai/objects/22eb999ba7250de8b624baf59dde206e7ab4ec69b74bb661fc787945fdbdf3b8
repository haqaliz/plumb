    "    local_R = np.diag(K)\n",
    "    max_local_R = float(np.max(local_R))\n",
    "\n",
    "    # Ecosystem-level criticality\n",
    "    global_R = spectral_radius(K)\n",
    "\n",
    "    # Effort changes the local timescale but not the threshold.\n",
    "    alpha = (\n",
    "        cfg.effort_multiplier\n",
    "        * alpha_star\n",
    "    )\n",
    "\n",
    "    # Dominant global amplification rate.\n",
    "    global_lambda = lambda_from_R(\n",
    "        global_R,\n",
    "        alpha,\n",
    "        cfg.tau\n",
    "    )\n",
    "\n",
    "    # Fastest actor if isolated.\n",
    "    local_lambdas = np.array([\n",
    "        lambda_from_R(\n",
    "            Ri,\n",
    "            alpha,\n",
    "            cfg.tau\n",
    "        )\n",
    "        for Ri in local_R\n",
    "    ])\n",
    "\n",
    "    max_local_lambda = float(\n",
    "        np.max(local_lambdas)\n",
    "    )\n",
    "\n",
    "    # Doubling time of a positive global perturbation.\n",
    "    if global_lambda > 0:\n",
    "        doubling_time = (\n",
    "            np.log(2) / global_lambda\n",
    "        )\n",
    "    else:\n",
    "        doubling_time = np.nan\n",
    "\n",
    "    # Contribution of cross-actor coupling to criticality.\n",
    "    coupling_increment = (\n",
    "        global_R - max_local_R\n",
    "    )\n",
    "\n",
    "    collective_only = (\n",
    "        max_local_R < 1.0\n",
