    "        1: (0.85, -0.45),\n",
    "        2: (0.00, 0.80),\n",
    "    }\n",
    "\n",
    "    # Add all directed links where K_ij > 0 (transfer FROM j TO i)\n",
    "    for i in range(n):\n",
    "        for j in range(n):\n",
    "            if i != j and K[i, j] > 0:\n",
