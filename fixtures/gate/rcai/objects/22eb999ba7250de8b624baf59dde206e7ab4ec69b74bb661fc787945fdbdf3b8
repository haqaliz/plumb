    "from scipy.special import expit\n",
    "from scipy.integrate import cumulative_trapezoid\n",
    "\n",
    "Array = np.ndarray\n",
    "\n",
    "def logistic(z):\n",
    "    \"\"\"Vectorized logistic function using scipy.special.expit.\"\"\"\n",
    "    return expit(z)\n",
    "\n",
    "def softplus(z):\n",
    "    if np.isscalar(z):\n",
    "        zz=float(z)\n",
    "        return max(zz,0.0)+math.log1p(math.exp(-abs(zz)))\n",
    "    z_arr=np.asarray(z,dtype=float)\n",
    "    return np.maximum(z_arr,0.0)+np.log1p(np.exp(-np.abs(z_arr)))\n",
    "\n",
    "@dataclass(frozen=True)\n",
    "class GainProfile:\n",
    "    g0: float\n",
    "    g_max: float\n",
    "    k: float\n",
    "    x_mid: float\n",
    "    a: float = 1.0\n",
    "\n",
    "    def _s0(self):\n",
    "        return 0 if self.k<0 else float(expit(-self.k*self.x_mid))\n",
    "\n",
    "    def gain(self,x):\n",
    "        if abs(self.g_max-self.g0)<1e-15 or self.k<0:\n",
    "            g_val = float(self.a*self.g0)\n",
    "            return g_val if np.isscalar(x) else np.full_like(np.asarray(x,dtype=float), g_val)\n",
    "        s0=self._s0(); scale=(self.g_max-self.g0)/(1-s0)\n",
    "        return self.a*(self.g0+scale*(expit(self.k*(np.asarray(x,dtype=float)-self.x_mid))-s0))\n",
    "\n",
    "    def potential(self, x):\n",
    "        # This formula is specific to g(x) = a * expit(k*x),\n",
    "        # which occurs when g0=0.5, g_max=1.0, and x_mid=0.\n",
    "        # The integral from 0 to x of a * expit(k*x') dx' is (a/k) * ln((1+e^(kx))/2)\n",
    "        if abs(self.k) < 1e-9: # Handle k near zero, g(x) approx constant a*g0\n",
    "            return self.a * self.g0 * np.asarray(x, dtype=float)\n",
    "\n",
    "        kx_val = self.k * np.asarray(x, dtype=float)\n",
    "        return (self.a / self.k) * np.log((np.exp(kx_val) + 1) / 2.0)\n",
    "\n",
    "    def potential_full(self, x):\n",
    "        # Check if analytical solution conditions are met\n",
    "        is_analytical_case = (\n",
    "            abs(self.x_mid) < 1e-9 and  # x_mid is effectively 0\n",
    "            abs(self.g0 - 0.5) < 1e-9 and # g0 is effectively 0.5\n",
    "            abs(self.g_max - 1.0) < 1e-9    # g_max is effectively 1.0\n",
    "        )\n",
    "\n",
    "        if is_analytical_case:\n",
    "            return self.potential(x)\n",
    "\n",
    "        # Original numerical integration fallback\n",
    "        if np.isscalar(x):\n",
    "            if x == 0: return 0.0\n",
    "            xx = np.linspace(0, float(x), 200)\n",
    "            return float(np.trapz(self.gain(xx), xx))\n",
    "\n",
    "        xa = np.asarray(x, dtype=float)\n",
    "        if xa.size == 0: return np.array([])\n",
    "\n",
    "        sorted_indices = np.argsort(xa)\n",
    "        sorted_x = xa[sorted_indices]\n",
    "\n",
    "        grid = np.unique(np.concatenate(([0.0], sorted_x)))\n",
    "        g_vals = self.gain(grid)\n",
    "\n",
    "        pot_grid = cumulative_trapezoid(g_vals, grid, initial=0)\n",
    "\n",
    "        return np.interp(xa, grid, pot_grid)\n",
    "\n",
    "@dataclass(frozen=True)\n",
    "class SmoothStep:\n",
    "    start: float\n",
    "    end: float\n",
    "    t_mid: float\n",
    "    k: float = 4.0\n",
    "    def __call__(self,t):\n",
    "        return self.start+(self.end-self.start)*expit(self.k*(np.asarray(t,dtype=float)-self.t_mid))\n",
    "\n",
    "def constant(value: float) -> SmoothStep:\n",
    "    return SmoothStep(value,value,0.0,1.0)\n"
