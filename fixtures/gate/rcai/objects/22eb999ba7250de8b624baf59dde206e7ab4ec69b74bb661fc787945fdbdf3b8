    "from dataclasses import dataclass\n",
    "from scipy.special import lambertw\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "@dataclass(frozen=True)\n",
    "class StrategicConfig:\n",
    "    name: str\n",
    "    nodes: tuple\n",
    "    K: Array\n",
    "    effort_multiplier: float\n",
    "    tau: float\n",
    "    description: str = \"\"\n",
    "\n",
    "\n",
    "def spectral_radius(K):\n",
    "    \"\"\"Perron root / spectral radius of non-negative reproduction matrix.\"\"\"\n",
    "    eigvals = np.linalg.eigvals(K)\n",
    "    return float(np.max(np.abs(eigvals)))\n",
    "\n",
    "\n",
    "def perron_vector(K):\n",
    "    \"\"\"Normalized dominant right eigenvector.\"\"\"\n",
    "    eigvals, eigvecs = np.linalg.eig(K)\n",
    "    i = np.argmax(np.real(eigvals))\n",
    "\n",
    "    vec = np.abs(np.real(eigvecs[:, i]))\n",
    "    return vec / np.sum(vec)\n",
    "\n",
    "\n",
    "def lambda_from_R(R, alpha, tau):\n",
    "    \"\"\"\n",
    "    Dominant characteristic root for\n",
    "\n",
    "        xi_dot = -alpha xi + alpha R xi(t-tau)\n",
    "\n",
    "    where alpha = v * sigma.\n",
    "    \"\"\"\n",
    "    if tau <= 1e-12:\n",
    "        return alpha * (R - 1.0)\n",
    "\n",
    "    arg = alpha * R * tau * np.exp(alpha * tau)\n",
    "\n",
    "    return float(\n",
    "        np.real(lambertw(arg, 0)) / tau\n",
    "        - alpha\n",
    "    )\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Reference state: weak-supercritical scenario at t = 0 (2026)\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "weak = scenarios[\"weak_supercritical\"]\n",
    "weak_result = results[\"weak_supercritical\"]\n",
    "\n",
    "# Strategic branching/calibration point: beginning of simulation\n",
    "x_star = weak.x0\n",
    "T_star = 0.0\n",
    "\n",
    "sigma_star = (\n",
    "    weak.beta\n",
    "    / (weak.X - x_star)\n",
    ")\n",
    "\n",
    "v_star = float(\n",
    "    np.interp(\n",
    "        T_star,\n",
    "        weak_result.time,\n",
    "        weak_result.local_velocity\n",
    "    )\n",
    ")\n",
    "\n",
    "g_star = float(\n",
    "    weak.gain_profile.gain(x_star)\n",
    ")\n",
    "\n",
    "R_star = g_star / sigma_star\n",
    "\n",
    "alpha_star = v_star * sigma_star\n",
    "\n",
    "print(f\"x*                = {x_star:.3f}\")\n",
    "print(f\"T*                = {T_star:.3f} yr\")\n",
    "print(f\"sigma(x*)         = {sigma_star:.3f}\")\n",
    "print(f\"g(x*)             = {g_star:.3f}\")\n",
    "print(f\"R_AI(x*)          = {R_star:.3f}\")\n",
    "print(f\"v(x*)             = {v_star:.4f} yr^-1\")\n",
    "print(f\"alpha = v sigma   = {alpha_star:.4f} yr^-1\")"
